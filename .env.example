# Optional: leave unset to use the actual Windows Desktop (including OneDrive).
# STORAGE_ROOT=C:\Users\YOUR_USER\Desktop\Gelen Dosyalar
# DATA_ROOT=C:\Users\YOUR_USER\AppData\Local\QRPrintInbox
TIMEZONE=Europe/Istanbul
MAX_FILE_SIZE_MB=25
MAX_SESSION_SIZE_MB=100
MAX_FILES_PER_SESSION=10
ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.xlsx,.jpg,.jpeg,.png
HOST=127.0.0.1
PORT=8000
SESSION_TTL_MINUTES=60
MIN_FREE_DISK_MB=512
# Required for the public tunnel. Generate locally; never commit the real secret.
# GATEWAY_SECRET=<at-least-32-random-characters>
REQUESTS_PER_MINUTE=120
SESSIONS_PER_MINUTE=20
SESSIONS_PER_DAY=2000
DAILY_UPLOAD_MB=4000
MAX_ACTIVE_UPLOADS=4
UPLOAD_TIMEOUT_SECONDS=180
